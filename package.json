{
  "name": "memory-mcp",
  "version": "0.1.0",
  "description": "Agent memory MCP server — markdown originals + SQLite derived index, with lifecycle states, supersede chains, conflict gates, and Korean-aware hybrid search",
  "license": "MIT",
  "type": "module",
  "bin": {
    "memory-mcp": "dist/main.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "start": "node src/main.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "packageManager": "pnpm@10.17.1"
}
